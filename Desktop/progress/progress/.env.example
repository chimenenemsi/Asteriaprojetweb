# Copy this file to .env inside the progress folder.
# Do not commit the real .env file.

# Shared MySQL database used by coaching, produits, and progress.
ASTERIA_DB_HOST=127.0.0.1
ASTERIA_DB_PORT=3306
ASTERIA_DB_NAME=asteria
ASTERIA_DB_USER=root
ASTERIA_DB_PASSWORD=

# Gemini / Google AI Studio key for Progress motivation, record insights, and AI Goal Survey.
GEMINI_API_KEY=put_your_rotated_gemini_key_here

# Optional fallback name accepted by Google tooling. Leave empty if using GEMINI_API_KEY.
GOOGLE_API_KEY=

# Default model used by the PHP REST integration.
GEMINI_MODEL=gemini-2.5-flash
